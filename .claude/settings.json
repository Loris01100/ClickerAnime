{
  "enabledPlugins": {
    "impeccable@impeccable": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-edit.mjs",
            "timeout": 180,
            "statusMessage": "Vérification du moteur / typecheck"
          }
        ]
      }
    ]
  }
}

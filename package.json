{
  "name": "clicker-anime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "vite-node -c vite.sim.config.ts scripts/validate-data.ts",
    "sim": "vite-node -c vite.sim.config.ts src/engine/sim.cli.ts",
    "deploy": "wrangler deploy",
    "sim:matrix": "vite-node -c vite.sim.config.ts src/engine/sim.matrix.cli.ts"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Doit correspondre **exactement** au Worker déjà créé dans le tableau de bord Cloudflare
  // (Workers & Pages › clickeranime) : c'est ce nom que `wrangler deploy` utilise pour choisir
  // sa cible. Un nom différent créerait un second Worker, et le domaine personnalisé
  // clickeranime.reesch.com resterait branché sur l'ancien.
  "name": "clickeranime",
  "compatibility_date": "2026-08-29",
  "main": "./src/worker.ts",

  // Les builds des branches non-production tournent `wrangler versions upload`, qui rend une URL
  // de prévisualisation par version — c'est ce qui donne à `development` son adresse de test.
  "preview_urls": true,

  // Les fichiers restent servis directement par Static Assets. Seul `/api/*` passe d'abord par le
  // Worker, pour recevoir les jalons de progression anonymes ; aucune navigation ni asset du jeu
  // ne paie ce passage. `single-page-application` garde le repli index.html des routes front-end.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Plafond par adresse sur /api/telemetry : le contrôle d'origine n'arrête qu'un navigateur, pas un
  // script. Un joueur légitime envoie au plus une poignée de jalons par session ; 20 par minute laisse
  // une marge large. `namespace_id` est un entier choisi librement, unique dans le compte.
  "ratelimits": [
    {
      "name": "TELEMETRY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Le dataset est créé automatiquement par Cloudflare à sa première écriture.
  "analytics_engine_datasets": [
    {
      "binding": "GAME_ANALYTICS",
      "dataset": "clickeranime_progression"
    }
  ]
}

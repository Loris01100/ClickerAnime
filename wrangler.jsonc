{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Doit correspondre **exactement** au Worker déjà créé dans le tableau de bord Cloudflare
  // (Workers & Pages › clickeranime) : c'est ce nom que `wrangler deploy` utilise pour choisir
  // sa cible. Un nom différent créerait un second Worker, et le domaine personnalisé
  // clickeranime.reesch.com resterait branché sur l'ancien.
  "name": "clickeranime",
  "compatibility_date": "2026-08-29",

  // Les builds des branches non-production tournent `wrangler versions upload`, qui rend une URL
  // de prévisualisation par version — c'est ce qui donne à `development` son adresse de test.
  "preview_urls": true,

  // Pas de champ `main` : ce Worker ne sert que des fichiers statiques, il n'exécute aucun code.
  // `single-page-application` renvoie `index.html` avec un **200** pour toute route qui ne
  // correspond à aucun fichier de `dist/`. Le jeu n'a pas encore de routeur, mais c'est aussi ce
  // qui rend le `base: "/"` de Vite obligatoire : en `base: "./"`, un `/un/chemin` inconnu servirait
  // un index.html dont les `./assets/…` se résoudraient sous `/un/`, donc en 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
